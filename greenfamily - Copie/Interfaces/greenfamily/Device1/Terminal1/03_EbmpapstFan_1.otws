<?xml version="1.0" encoding="utf-8"?>
<Worksheet Name="03_EbmpapstFan_1" Version="1.0.0">
  <Loop Name="EBM_1" X="1" Y="1">
    <Mask Name="FanStatus_1_EBM_1" Type="Normal" X="1" Y="2">
      <Fields>
