    <DataType Name="GEN_IPCFG" Comment="" Access="ReadOnly">
      <Struct FieldOrder="0" Order="1">
        <Variable Name="SysErr" DataType="DINT" Comment="System Error Descriptor 0-99" StringSize="0" Order="1" />
        <Variable Name="ShowErr" DataType="BOOL" Comment="True if an error has occurred in UI" StringSize="0" Order="2" />
        <Variable Name="EnReadStatus" DataType="BOOL" Comment="Enable the status reading" StringSize="0" Order="3" />
        <Variable Name="EnReboot" DataType="INT" Comment="Enables system reboot from UI" StringSize="0" Order="4" />
        <Variable Name="UpdCfg" DataType="INT" Comment="Update Configuration shown in the UI. 0 = NO / 1 = YES" StringSize="0" Order="5" />
        <Variable Name="PgLimit" DataType="SINT" Comment="Pages limit. 2 = IPv6 disabled / 4 = IPv6 enabled" StringSize="0" Order="6" />
        <Variable Name="FirstCycleExec" DataType="BOOL" Comment="First program cycle executed" StringSize="0" Order="7" />
        <Variable Name="EnIPCFG" DataType="BOOL" Comment="Enables IPCFG configuration" StringSize="0" Order="8" />
        <Variable Name="DisableIP_msk" DataType="UDINT" Comment="Time shown in the UI to set the countdown after which the EnIPCFG is set to false" StringSize="0" Order="9" />
        <Variable Name="IntervalReadIP_msk" DataType="UDINT" Comment="Time interval shown in the UI, between each IP reading" StringSize="0" Order="10" />
        <Variable Name="DisableConstantReading" DataType="BOOL" Comment="Enable shown in the UI to turn on/off the continuous IP reading" StringSize="0" Order="11" />
        <Variable Name="PrevIntervalReadIP_msk" DataType="UDINT" Comment="Previous IntervalReadIP_msk - It changes once the variable has changed" StringSize="0" Order="12" />
        <Variable Name="PrevDisableIP_msk" DataType="UDINT" Comment="Previous DisableIP_msk - It changes once the variable has changed" StringSize="0" Order="13" />
        <Variable Name="ErrorSignalCnt" DataType="USINT" Comment="Used to reboot the c.pCO only if there was no error" StringSize="0" Order="14" />
        <Variable Name="ResetTimerInactivity" DataType="BOOL" Comment="If true resets the (default) 20 min timer. It's used to know it the user is still in the mask" StringSize="0" Order="15" />
      </Struct>
    </DataType>
