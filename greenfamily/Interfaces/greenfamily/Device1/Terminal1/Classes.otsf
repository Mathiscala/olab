<?xml version="1.0" encoding="utf-8"?>
<FormatFields>
  <FormatField Name="ActDeactBool_PWRP" Format="iob">
    <KeyBindings>
      <KeyBinding Key="UP" BindOn="BoolSwap" />
      <KeyBinding Key="DOWN" BindOn="BoolSwap" />
      <KeyBinding Key="ENTER" BindOn="SetCurrentValue" />
    </KeyBindings>
    <ResourceUsedOnBool>
      <Index Value="0" Content="DEACTIVE" Type="Text" Font="CAREL_TERM_INT" ProportionalCharWidth="true" />
      <Index Value="1" Content="ACTIVE" Type="Text" Font="CAREL_TERM_INT" ProportionalCharWidth="true" />
    </ResourceUsedOnBool>
  </FormatField>
  <FormatField Name="ActiveCtrlMode_EBM" Format="o1">
    <KeyBindings>
      <KeyBinding Key="UP" BindOn="Increment_WORD" />
      <KeyBinding Key="DOWN" BindOn="Decrement_WORD" />
      <KeyBinding Key="ENTER" BindOn="SetCurrentValue" />
    </KeyBindings>
    <ResourceUsedOnInt>
      <Index Value="0" Content="rpm" Type="Text" Font="CAREL_TERM_INT" ProportionalCharWidth="true" />
      <Index Value="1" Content="V" Type="Text" Font="CAREL_TERM_INT" ProportionalCharWidth="true" />
      <Index Value="2" Content="%" Type="Text" Font="CAREL_TERM_INT" ProportionalCharWidth="true" />
      <Index Value="3" Content="m3/h" Type="Text" TextFactor="2" LimitText="false" Font="CAREL_TERM_INT" FontHeight="9" ProportionalCharWidth="true" />
      <Index Value="4" Content="kg/h" Type="Text" TextFactor="2" LimitText="false" Font="CAREL_TERM_INT" FontHeight="9" ProportionalCharWidth="true" />
    </ResourceUsedOnInt>
  </FormatField>
  <FormatField Name="AlarmCode_PWRP" Format="o2">
    <ResourceUsedOnInt>
      <Index Value="0" Content="0: No fault" Type="Text" Font="SimSun" />
      <Index Value="1" Content="1: Overcurrent" Type="Text" Font="SimSun" />
      <Index Value="2" Content="2: Motor overload" Type="Text" Font="SimSun" />
      <Index Value="3" Content="3: Overvoltage" Type="Text" Font="SimSun" />
      <Index Value="4" Content="4: Undervoltage" Type="Text" Font="SimSun" />
      <Index Value="5" Content="5: Drive overT." Type="Text" Font="SimSun" />
      <Index Value="6" Content="6: Drive underT" Type="Text" Font="SimSun" />
      <Index Value="7" Content="7: Overcurrent HW" Type="Text" Font="SimSun" />
      <Index Value="8" Content="8: Motor overtemp." Type="Text" Font="SimSun" />
      <Index Value="9" Content="9: Drive failure" Type="Text" Font="SimSun" />
      <Index Value="10" Content="10: Cpu error" Type="Text" Font="SimSun" />
      <Index Value="11" Content="11: Param. default" Type="Text" Font="SimSun" />
      <Index Value="12" Content="12: DC bus ripple" Type="Text" Font="SimSun" />
      <Index Value="13" Content="13: Data comms fault" Type="Text" Font="SimSun" />
      <Index Value="14" Content="14: Drive thermistor" Type="Text" Font="SimSun" />
      <Index Value="15" Content="15: Autotune fault" Type="Text" Font="SimSun" />
      <Index Value="16" Content="16: Drive disabled" Type="Text" Font="SimSun" />
      <Index Value="17" Content="17: Motor phase" Type="Text" Font="SimSun" />
      <Index Value="18" Content="18: Fan fault" Type="Text" Font="SimSun" />
      <Index Value="19" Content="19: Speed fault" Type="Text" Font="SimSun" />
      <Index Value="20" Content="20: PFC failure" Type="Text" Font="SimSun" />
      <Index Value="21" Content="21: error code 21" Type="Text" Font="SimSun" />
      <Index Value="22" Content="22: PFC undervoltage" Type="Text" Font="SimSun" />
      <Index Value="23" Content="23: STO survey fail" Type="Text" Font="SimSun" />
      <Index Value="24" Content="24: STO survey fail" Type="Text" Font="SimSun" />
      <Index Value="25" Content="25: error code 25" Type="Text" Font="SimSun" />
      <Index Value="26" Content="26: error code 26" Type="Text" Font="SimSun" />
      <Index Value="27" Content="27: error code 27" Type="Text" Font="SimSun" />
      <Index Value="28" Content="28: error code 28" Type="Text" Font="SimSun" />
      <Index Value="29" Content="29: error code 29" Type="Text" Font="SimSun" />
      <Index Value="30" Content="30: error code 30" Type="Text" Font="SimSun" />
      <Index Value="99" Content="99:Unexp.Inverter Stop" Type="Text" Font="SimSun" />
    </ResourceUsedOnInt>
  </FormatField>
  <FormatField Name="AlarmConfig_PWRP" Format="iob">
    <KeyBindings>
      <KeyBinding Key="UP" BindOn="BoolSwap" />
      <KeyBinding Key="DOWN" BindOn="BoolSwap" />
      <KeyBinding Key="ENTER" BindOn="SetCurrentValue" />
    </KeyBindings>
    <ResourceUsedOnBool>
      <Index Value="0" Content="man.bmp" Type="Image" Font="CAREL_TERM_INT" ProportionalCharWidth="true" />
      <Index Value="1" Content="aut.bmp" Type="Image" Font="CAREL_TERM_INT" ProportionalCharWidth="true" />
    </ResourceUsedOnBool>
  </FormatField>
  <FormatField Name="AlarmLogDelete" Format="iob">
    <ResourceUsedOnBool>
      <Index Value="0" Content="  NO" Type="Text" Font="CAREL_TERM_INT" ProportionalCharWidth="true" />
      <Index Value="1" Content=" YES" Type="Text" Font="CAREL_TERM_INT" ProportionalCharWidth="true" />
    </ResourceUsedOnBool>
    <KeyBindings>
      <KeyBinding Key="ENTER" BindOn="DeleteAlarmLog" />
      <KeyBinding Key="UP" BindOn="BoolSwap" />
      <KeyBinding Key="DOWN" BindOn="BoolSwap" />
    </KeyBindings>
  </FormatField>
